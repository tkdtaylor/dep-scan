#!/bin/sh
# cargods — dep-scan wrapper for cargo
# Scans packages with dep-scan before passing through to cargo.
# Install: cp shims/cargods ~/.local/bin/cargods

set -e

flags=''
pkgs=''

for arg in "$@"; do
    case "$arg" in
        -*) flags="$flags $arg" ;;
        *)  pkgs="$pkgs $arg"   ;;
    esac
done

if [ -n "$pkgs" ]; then
    # shellcheck disable=SC2086
    dep-scan check --registry crates $pkgs
fi

# shellcheck disable=SC2086
exec cargo "$@"
